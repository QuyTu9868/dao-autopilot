      "css": ".ds-trail{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);font:500 1rem 'Hanken Grotesk',system-ui,sans-serif;color:#2C2E2A}.ds-trail li{position:relative;display:flex;flex-direction:column;gap:6px}.ds-trail li:not(:last-child)::before{content:'';position:absolute;top:10px;left:28px;right:6px;border-top:2px solid #2C2E2A}.ds-trail li.todo:not(:last-child)::before{border-top-style:dashed}.ds-dot{width:22px;height:22px;border-radius:50%;border:2px solid #2C2E2A;background:#FFFDF6}.done .ds-dot{background:#2C2E2A}.for .ds-dot{background:#8ED462}.against .ds-dot{background:#FF705D}.now .ds-dot{background:#F5E211}"
    }
