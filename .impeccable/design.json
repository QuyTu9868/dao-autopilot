  "narrative": {
    "northStar": "The Trail Map",
    "overview": "The app reads like a printed park guide. Cream is the water, apple green is the land, and every proposal is a route with four stops you follow left to right.",
    "keyCharacteristics": [
      "Flat colour fields, no gradients, no grain, no glass.",
      "Organic corners: lobes swell on one side, controls are full pills.",
      "One authored motion: a spring pop when a stop completes.",
      "Operate-first: the current step and its single action are the loudest thing on screen."
    ],
    "rules": [
      {
        "name": "The Colour Means Rule",
        "body": "A state colour is never decoration. Green, coral and lilac appear only on outcomes, yellow only on the live step or action, blue only on information.",
        "section": "colors"
      },
      {
        "name": "The Words Too Rule",
        "body": "Every state carries a text label as well as a colour.",
        "section": "colors"
      },
      {
        "name": "The One Weight Rule",
        "body": "Never switch to bold. Emphasis is a colour pill or a size step.",
        "section": "typography"
      },
      {
        "name": "The Flat Coast Rule",
        "body": "No box shadows, no blur, no gradients on our own surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep one yellow action per screen state, at the current setup step.",
      "Do pair every state colour with a word.",
      "Do show wallet states plainly: signing, pending, confirmed, rejected, failed.",
      "Do keep the one spring motion for completion only, and honour reduced motion."
    ],
    "donts": [
      "Don't add shadows, gradients or glass to our own surfaces.",
      "Don't use bold type or a second typeface.",
      "Don't use a dark neon wallet-dashboard look.",
      "Don't use em dashes in any copy.",
      "Don't use a coloured side border on rows or callouts."
    ]
  }
